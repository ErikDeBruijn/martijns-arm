<?xml version="1.0"?>
<!--
  Gazebo-specifieke aanvullingen op de basis URDF:
    - Visual material tags die Gazebo begrijpt
    - ros2_control hardware interface (gz_ros2_control plugin)
    - Plugin block voor de Gazebo controller manager bridge

  Gebruik dit bestand i.p.v. de pure description URDF wanneer je in
  Gazebo simuleert.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="martijns_arm">

  <!-- Inherit alle links en joints van de basis URDF -->
  <xacro:include filename="$(find martijns_arm_description)/urdf/martijns_arm.urdf.xacro"/>

  <!-- ======== ROS2_CONTROL hardware interface ======== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="joint_iface" params="name">
      <joint name="${name}">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:joint_iface name="joint_1"/>
    <xacro:joint_iface name="joint_2"/>
    <xacro:joint_iface name="joint_3"/>
  </ros2_control>

  <!-- ======== GAZEBO PLUGIN: controller_manager wiring ======== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find martijns_arm_gazebo)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Gazebo material kleuren voor de links -->
  <gazebo reference="base_link">      <material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="post_link">      <material>Gazebo/Grey</material></gazebo>
  <gazebo reference="upper_link">     <material>Gazebo/Grey</material></gazebo>
  <gazebo reference="forearm_link">   <material>Gazebo/Orange</material></gazebo>
  <gazebo reference="ee_link">        <material>Gazebo/DarkGrey</material></gazebo>
</robot>
